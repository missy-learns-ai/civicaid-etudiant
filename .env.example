# Local defaults. Do not put real secrets in this file.
CIVICAID_API_BASE_URL=http://127.0.0.1:8000
ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Backend storage. Local default is SQLite. In Render, set this to the
# managed Postgres internal connection string.
DATABASE_URL=sqlite:///./data/civicaid.db

# React/Vite frontend variables. Anything prefixed with VITE_ is public in
# the browser bundle, so do not put private API keys here.
VITE_CIVICAID_API_BASE_URL=http://127.0.0.1:8000
VITE_ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Optional. If set on the backend, ElevenLabs and the dashboard must send
# this value as X-CivicAid-Tool-Token. Keep the real value in your host's
# environment-variable settings, not in GitHub.
CIVICAID_TOOL_TOKEN=
